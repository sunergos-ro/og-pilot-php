{
    "name": "sunergos/og-pilot-php",
    "description": "PHP client for the OG Pilot Open Graph image generator with Laravel support.",
    "keywords": ["og-pilot", "opengraph", "og-image", "social-media", "laravel"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Sunergos IT LLC",
            "email": "office@sunergos.ro"
        },
        {
            "name": "Raul Popadineti",
            "email": "raul@sunergos.ro"
        }
    ],
    "homepage": "https://ogpilot.com",
    "require": {
        "php": "^8.1",
        "firebase/php-jwt": "^6.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Sunergos\\OgPilot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sunergos\\OgPilot\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sunergos\\OgPilot\\OgPilotServiceProvider"
            ],
            "aliases": {
                "OgPilot": "Sunergos\\OgPilot\\Facades\\OgPilot"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
